# Telegram Bot Token obtained from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Maximum concurrent video downloads (default: 3)
MAX_CONCURRENT_DOWNLOADS=3

# Maximum video file size in Megabytes for Telegram Bot API upload (Telegram limit is 50MB)
MAX_FILE_SIZE_MB=100

# Auto-download in groups: "true" to automatically detect and download links in groups, "false" to require /dl command
AUTO_DOWNLOAD_IN_GROUPS=true

# Delete download status messages upon completion (keeps chat clean)
CLEANUP_STATUS_MESSAGES=true

# Optional: Restrict bot usage to specific user IDs or chat IDs (comma-separated, leave blank for public)
# ALLOWED_CHATS=12345678, -100987654321
ALLOWED_CHATS=
